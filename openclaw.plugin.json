{
  "id": "identyclaw-tools",
  "name": "IdentyClaw Tools",
  "description": "OpenClaw agent tools for the IdentyClaw HTTP API",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "baseUrl": {
        "description": "IdentyClaw API base URL (default https://api.identyclaw.com)",
        "type": "string"
      },
      "accountid": {
        "description": "64-char hex NEAR implicit account id",
        "type": "string"
      },
      "roditid": {
        "description": "Deprecated alias for accountid; use accountid instead",
        "type": "string"
      },
      "nearPrivateKey": {
        "description": "NEAR private key value, usually prefixed with ed25519:",
        "type": "string"
      },
      "nearCredentialsOutputDirs": {
        "type": "array",
        "items": {
          "description": "Allowlisted output directories for identyclaw_generate_near_account (in addition to paths ending in secrets/near-credentials)",
          "type": "string"
        }
      },
      "generateNearAccountDefaultDir": {
        "description": "Default output directory for identyclaw_generate_near_account when outputDir is omitted",
        "type": "string"
      },
      "generateNearAccountOnInstall": {
        "description": "When true (default), create NEAR credentials on first gateway startup if accountid/nearPrivateKey are unset and no credential file exists yet",
        "type": "boolean"
      }
    }
  },
  "version": "1.5.2",
  "contracts": {
    "tools": [
      "identyclaw_list_agents",
      "identyclaw_get_my_identity",
      "identyclaw_get_nonce",
      "identyclaw_create_hola",
      "identyclaw_verify_hola",
      "identyclaw_generate_near_account",
      "identyclaw_list_resources",
      "identyclaw_get_resource",
      "identyclaw_get_agent_identity",
      "identyclaw_check_subagent_signer",
      "identyclaw_resolve_did"
    ]
  },
  "toolMetadata": {
    "identyclaw_get_my_identity": {
      "optional": true
    },
    "identyclaw_get_nonce": {
      "optional": true
    },
    "identyclaw_create_hola": {
      "optional": true
    },
    "identyclaw_verify_hola": {
      "optional": true
    },
    "identyclaw_generate_near_account": {
      "optional": true
    },
    "identyclaw_get_agent_identity": {
      "optional": true
    },
    "identyclaw_check_subagent_signer": {
      "optional": true
    },
    "identyclaw_resolve_did": {
      "optional": true
    }
  }
}
